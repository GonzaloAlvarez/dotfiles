# Managed by seshat (dotfiles bundle localllm.server) - do not edit by hand;
# change with: seshat install localllm.server --set <name>=<value>
# Read by ~/bin/localllm (gear com/localllm). Environment variables override
# any of these at runtime, e.g.: KV_QUANT=f16 localllm serve
MODEL_HF_REPO={{ vars.model_hf_repo }}
MODEL_FILE={{ vars.model_file }}
MODEL_SHA256={{ vars.model_sha256 }}
MODEL_ALIAS={{ vars.model_alias }}
HOST={{ vars.bind }}
PORT={{ vars.port }}
CTX={{ vars.ctx }}
NGL={{ vars.ngl }}
NP=1
FLASH_ATTN=on
KV_QUANT={{ vars.kv_quant }}
SPEC_TYPE={{ vars.spec_type }}
EXTRA_ARGS=
# Router mode (two model ids from one llama-server) is on when MODEL2_ALIAS
# is set; MODEL2_FILE empty = the same GGUF under both aliases. MODEL_ARGS /
# MODEL2_ARGS hold that alias' llama-server options as space-separated
# key=value tokens (long flag names without dashes); single-quoted because
# JSON values such as chat-template-kwargs carry double quotes.
MODEL2_HF_REPO={{ vars.model2_hf_repo }}
MODEL2_FILE={{ vars.model2_file }}
MODEL2_SHA256={{ vars.model2_sha256 }}
MODEL2_ALIAS={{ vars.model2_alias }}
MODEL_ARGS='{{ vars.model_args }}'
MODEL2_ARGS='{{ vars.model2_args }}'
SERVER_ENV='{{ vars.server_env }}'
SLEEP_IDLE={{ vars.sleep_idle }}
MODELS_MAX={{ vars.models_max }}
