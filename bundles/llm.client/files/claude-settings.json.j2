{
  "env": {
    "ANTHROPIC_BASE_URL": {{ vars.router_url | tojson }},
    "ANTHROPIC_AUTH_TOKEN": "open",
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_MODEL": {{ vars.default_model | tojson }},
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-flash",
    "CLAUDE_CODE_GATEWAY_HINT_HEADERS": "1",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "200000",
    "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1"
  },
  "modelPicker": {
    "options": [
      { "model": "auto",             "label": "Auto",                    "description": "local Qwen for easy turns, DeepSeek 4.1 Flash for hard ones; pinned per session" },
      { "model": "deepseek-flash",   "label": "DeepSeek 4.1 Flash",      "description": "Fireworks, 1M context, cheapest strong model" },
      { "model": "claude-opus",      "label": "Claude Opus (Bedrock)",   "description": "us.anthropic.claude-opus-5 via the router", "behavesAs": "claude-opus-4-8" },
      { "model": "claude-sonnet",    "label": "Claude Sonnet (Bedrock)", "description": "us.anthropic.claude-sonnet-5 via the router", "behavesAs": "claude-sonnet-4-6" },
      { "model": "qwen-local",       "label": "Qwen3.8-27B (local pool)", "description": "first local box that is up: minerva, klaus, travelblock" },
      { "model": "qwen-klaus",       "label": "Qwen3.8-27B on klaus",    "description": "64k context, MTP; on demand" },
      { "model": "qwen-minerva",     "label": "Qwen3.8-27B on minerva",  "description": "32k context; usually serving" },
      { "model": "qwen-travelblock", "label": "Qwen3.8-27B on travelblock", "description": "32k context; always on at home, roams" },
      { "model": "gpt-5.5",          "label": "GPT-5.5 (Bedrock)",       "description": "native Chat Completions on bedrock-runtime" },
      { "model": "nova-2-lite",      "label": "Nova 2 Lite (Amazon)",    "description": "Nova developer API; cheap reasoning model, 1M context" },
      { "model": "nova-pro",         "label": "Nova Pro (Amazon)",       "description": "Nova developer API; multimodal, 300k context" },
      { "model": "nova-lite",        "label": "Nova Lite (Amazon)",      "description": "Nova developer API; fastest multimodal, 300k context" },
      { "model": "nova-micro",       "label": "Nova Micro (Amazon)",     "description": "Nova developer API; tiny text-only model, 128k context" }
    ],
    "replaceBuiltInOptions": true
  }
}
